FROM alpine:latest

ARG VERSION
ARG TARGETARCH
ARG TARGETVARIANT
ARG FILE_VERSION

RUN apk add --no-cache tzdata tini bash ca-certificates gcompat libgcc libstdc++

COPY scripts/download.sh /download.sh
RUN apk add --no-cache --virtual .dl-deps curl unzip && \
    chmod +x /download.sh && \
    /download.sh "$VERSION" "$TARGETARCH" "$TARGETVARIANT" "$FILE_VERSION" && \
    rm -f /download.sh /usr/local/bin/easytier-web && \
    apk del .dl-deps

COPY --chmod=755 scripts/run.nightly.sh /run.sh

RUN mkdir -p /app/data/config /app/data/web /app/logs/web /app/logs/core

VOLUME /app/data

WORKDIR /app/data

ENTRYPOINT ["/sbin/tini", "--", "/run.sh"]
